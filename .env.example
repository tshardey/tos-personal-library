# Host path of the Tome of Secrets checkout (or worktree) that owns supabase/migrations
TOS_REPO_PATH=../tome-of-secrets
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional. Google Books key for covers and descriptions OpenLibrary lacks; blank skips Google.
VITE_GOOGLE_BOOKS_API_KEY=
# Optional. Where the app reads Tome of Secrets' bookTags.json; blank uses /tome-of-secrets/assets/data/bookTags.json.
VITE_TOS_BOOK_TAGS_URL=
# Dev server only. Where the Vite proxy sends /tome-of-secrets (a local Jekyll); defaults to http://host.docker.internal:4000.
# TOS_JEKYLL_URL=http://host.docker.internal:4000
